# Template only: copy to .env (git-ignored) and put real keys THERE, never in this file.
# Every key is optional: the agent degrades gracefully without it.

# LLM: parses the officer's request and writes the English alert. Groq is tried first, Gemini
# second. One Groq key works for every Groq model; pick the model with GROQ_MODEL.
# Without either, alerts use a deterministic English template.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Bodhan AI (IIT Madras / AI4Bharat), https://console.bodhan.ai. The console issues one key per model.
BODHAN_TRANSLATE_API_KEY=   # Indic-Translate: English alert -> Tamil
BODHAN_TTS_API_KEY=         # Indic-Speak: Tamil voice alert
BODHAN_VOICE=Anitha         # Tamil voices: Anitha (female), Arun (male)

# Routing needs no key: FOSSGIS's public Valhalla server, with OSRM as fallback.

# Telegram: approved alerts are posted to this channel (English, then Tamil).
# Bot token from @BotFather (/newbot). Add the bot to the channel as an admin that can post.
TELEGRAM_BOT_TOKEN=
# A public channel's handle, e.g. @ChennaiFloodAlert. The app's "Join alerts" link is derived from it.
TELEGRAM_CHAT_ID=
# Only needed for a private channel: its invite link
# TELEGRAM_CHANNEL_URL=

# Identify the app to OSM / FOSSGIS services (their usage policies ask for this). Add a contact.
USER_AGENT=chennai-flood-agent/0.1 (hackathon prototype)

# Optional tuning
# APP_NAME=Chennai Flood Agent
# GRID_STEP_DEG=0.025
# MAX_ROUTES=5
# DATABASE_PATH=data/cache.sqlite3
